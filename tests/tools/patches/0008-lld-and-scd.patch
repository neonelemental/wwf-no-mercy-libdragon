+DECLARE_INSTRUCTION(LLD)
+{
+    DECLARE_R4300
+    const uint32_t lsaddr = address32(irs + iimmediate);
+    int64_t *lsrtp = &irt;
+    ADD_TO_PC(1);
+
+    if (r4300_read_aligned_dword(r4300, lsaddr, (uint64_t*)lsrtp)) {
+        r4300->llbit = 1;
+    }
+}
+
 DECLARE_INSTRUCTION(LW)
 {
     DECLARE_R4300
@@ -373,6 +385,26 @@
     if (r4300->llbit)
     {
         if (r4300_write_aligned_word(r4300, lsaddr, (uint32_t)*lsrtp, ~UINT32_C(0))) {
+            r4300->llbit = 0;
+            *lsrtp = 1;
+        }
+    }
+    else
+    {
+        *lsrtp = 0;
+    }
+}
+
+DECLARE_INSTRUCTION(SCD)
+{
+    DECLARE_R4300
+    const uint32_t lsaddr = address32(irs + iimmediate);
+    int64_t *lsrtp = &irt;
+    ADD_TO_PC(1);
+
+    if (r4300->llbit)
+    {
+        if (r4300_write_aligned_dword(r4300, lsaddr, (uint64_t)*lsrtp, ~UINT64_C(0))) {
             r4300->llbit = 0;
             *lsrtp = 1;
         }
