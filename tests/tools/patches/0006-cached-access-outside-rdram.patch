+
+/* A console stops on a cached access outside RDRAM. Say where it was. */
+static void cached_access(struct r4300_core* r4300, uint32_t address)
+{
+    static int said;
+
+    if ((address & UINT32_C(0xe0000000)) == UINT32_C(0x80000000)
+        && (address & UINT32_C(0x1fffffff)) >= UINT32_C(0x03f00000)
+        && said < 4) {
+        said++;
+        DebugMessage(M64MSG_ERROR, "cached access outside RDRAM: address %08x, pc %08x",
+            address, *r4300_pc(r4300));
+    }
 }
 
