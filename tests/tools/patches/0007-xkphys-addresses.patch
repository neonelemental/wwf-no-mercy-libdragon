 /* M64P Pseudo instructions */
 
+/* The R4300 has 64-bit addresses, and this core 32-bit ones. A 64-bit address
+ * of the physical segment (xkphys) becomes the KSEG1 address of its physical
+ * address, or the KSEG0 one when its cache mode is not the uncached one. */
+static uint32_t address32(int64_t address)
+{
+    if (((uint64_t) address >> 62) == 2) {
+        uint32_t segment = (((uint64_t) address >> 59) & 7) == 2 ? UINT32_C(0xa0000000) : UINT32_C(0x80000000);
+        return segment | ((uint32_t) address & UINT32_C(0x1fffffff));
+    }
+    return (uint32_t) address;
+}
