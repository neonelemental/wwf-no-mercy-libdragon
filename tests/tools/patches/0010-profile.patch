+/* The profile of a run. For each instruction of RDRAM it counts the times it
+ * ran and the cache misses it had, on a model of the caches of the VR4300:
+ * 16 KB of instructions in lines of 32 bytes and 8 KB of data in lines of 16
+ * bytes, each direct mapped. It also counts each jump by its two ends, with 1
+ * in the first for a jump that links. A tag is the address of the line, with
+ * 1 for a line that is there and 2 for a dirty one. The last counter takes
+ * each instruction outside RDRAM. */
+#define PROFILE_WORDS 0x200000
+#define PROFILE_JUMPS 0x10000
+int profile_on;
+static struct profile_counts { uint32_t runs, code, data, back; } *profile_at, *profile_now;
+static struct { uint32_t from, to, count; } *profile_jumps;
+static uint32_t profile_code[512], profile_data[512];
+
+static void profile_jump(uint32_t from, uint32_t to)
+{
+    uint32_t i, tries;
+
+    i = (from * UINT32_C(2654435761) ^ to * UINT32_C(40503)) % PROFILE_JUMPS;
+    for (tries = 0; tries < PROFILE_JUMPS; tries++, i = (i + 1) % PROFILE_JUMPS) {
+        if (profile_jumps[i].count == 0 || (profile_jumps[i].from == from && profile_jumps[i].to == to)) {
+            profile_jumps[i].from = from;
+            profile_jumps[i].to = to;
+            profile_jumps[i].count++;
+            return;
+        }
+    }
+}
+
+/* The CACHE instructions that libultra and libdragon use on a line. */
+static void profile_cache(uint32_t op, uint32_t address)
+{
+    uint32_t* code = &profile_code[(address >> 5) & 511];
+    uint32_t* data = &profile_data[(address >> 4) & 511];
+    uint32_t dirty = (*data >> 1) & 1;
+    int hit = (*data & ~UINT32_C(2)) == ((address & ~UINT32_C(15)) | 1);
+
+    switch (op) {
+    case 0x00: *code = 0; break;
+    case 0x10: if (*code == ((address & ~UINT32_C(31)) | 1)) { *code = 0; } break;
+    case 0x01: profile_now->back += dirty; *data = 0; break;
+    case 0x0d: if (!hit) { profile_now->back += dirty; } *data = (address & ~UINT32_C(15)) | 3; break;
+    case 0x11: if (hit) { *data = 0; } break;
+    case 0x15: if (hit) { profile_now->back += dirty; *data = 0; } break;
+    case 0x19: if (hit) { profile_now->back += dirty; *data &= ~UINT32_C(2); } break;
+    }
+}
+
+/* Called before each instruction. */
+void profile_step(struct r4300_core* r4300, uint32_t pc, uint32_t op)
+{
+    uint32_t line = (pc & ~UINT32_C(31)) | 1;
+    uint32_t base = (uint32_t) r4300_regs(r4300)[(op >> 21) & 31];
+
+    profile_now = &profile_at[PROFILE_WORDS];
+    if ((pc & UINT32_C(0xff800000)) == UINT32_C(0x80000000)) {
+        profile_now = &profile_at[(pc & UINT32_C(0x7fffff)) >> 2];
+        if (profile_code[(pc >> 5) & 511] != line) {
+            profile_code[(pc >> 5) & 511] = line;
+            profile_now->code++;
+        }
+    }
+    profile_now->runs++;
+    switch (op >> 26) {
+    case 0: if ((op & 0x3e) == 8) { profile_jump(pc | (op & 1), base); } break;
+    case 2: case 3: profile_jump(pc | ((op >> 26) & 1), (pc & UINT32_C(0xf0000000)) | ((op & UINT32_C(0x3ffffff)) << 2)); break;
+    case 47: profile_cache((op >> 16) & 31, base + (uint32_t) (int16_t) op); break;
+    }
+}
+
+/* Called at each load and store. */
+static void profile_access(uint32_t address, int write)
+{
+    uint32_t* tag = &profile_data[(address >> 4) & 511];
+
+    if (!profile_on || (address & UINT32_C(0xe0000000)) != UINT32_C(0x80000000)) { return; }
+    if ((*tag & ~UINT32_C(2)) != ((address & ~UINT32_C(15)) | 1)) {
+        profile_now->data++;
+        profile_now->back += (*tag >> 1) & 1;
+        *tag = (address & ~UINT32_C(15)) | 1;
+    }
+    if (write) { *tag |= 2; }
+}
+
+/* The harness starts the count with no path, from empty caches. With a path
+ * it ends the count and writes it there: the game frames that the harness
+ * saw, each instruction that ran, with its word, and each jump. */
+EXPORT int CALL DebugProfile(const char* path, unsigned int frames)
+{
+    uint32_t i;
+    FILE* file;
+
+    if (path == NULL) {
+        free(profile_at);
+        free(profile_jumps);
+        profile_at = calloc(PROFILE_WORDS + 1, sizeof(*profile_at));
+        profile_jumps = calloc(PROFILE_JUMPS, sizeof(*profile_jumps));
+        memset(profile_code, 0, sizeof(profile_code));
+        memset(profile_data, 0, sizeof(profile_data));
+        profile_now = &profile_at[PROFILE_WORDS];
+        profile_on = profile_at != NULL && profile_jumps != NULL;
+        return !profile_on;
+    }
+    file = profile_on ? fopen(path, "w") : NULL;
+    profile_on = 0;
+    if (file == NULL) { return 1; }
+    fprintf(file, "frames %u\n", frames);
+    for (i = 0; i <= PROFILE_WORDS; i++) {
+        const struct profile_counts* at = &profile_at[i];
+        if (at->runs != 0) {
+            fprintf(file, "at %08x %08x %u %u %u %u\n", UINT32_C(0x80000000) + (i << 2),
+                i < PROFILE_WORDS ? *mem_base_u32(g_dev.r4300.mem->base, i << 2) : 0,
+                at->runs, at->code, at->data, at->back);
+        }
+    }
+    for (i = 0; i < PROFILE_JUMPS; i++) {
+        if (profile_jumps[i].count != 0) {
+            fprintf(file, "%s %08x %08x %u\n", (profile_jumps[i].from & 1) ? "call" : "jump",
+                profile_jumps[i].from & ~UINT32_C(1), profile_jumps[i].to, profile_jumps[i].count);
+        }
+    }
+    return fclose(file) != 0;
+}
