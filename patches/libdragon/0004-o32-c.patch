+	// delta * tempo_us * rate can exceed 64 bits, so divide delta * tempo_us first.
+	uint64_t a = (uint64_t)delta * p->tempo_us;
+	uint64_t t = (a % den) * p->sample_rate + p->timing_remainder;
+	uint64_t samples = (a / den) * p->sample_rate + t / den;
+	p->timing_remainder = t % den;
 	return samples;
 }
 
