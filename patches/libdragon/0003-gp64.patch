--- a/src/mi_memset.S
+++ b/src/mi_memset.S
@@ -4,6 +4,7 @@
 # Authors: Giovanni Bajo <giovannibajo@gmail.com>
 #########################################################################
 
+    .set gp=64
 #include "regs.S"
 #define MI_WMODE_SET_REPEAT_MODE        0x100
 
@@ -50,7 +51,19 @@
 __mi_memset32:
     dsll t0, val, 32
     or val, t0
+#if _MIPS_SIM == _ABIO32
+    b .Lmemset64
+     nop
 __mi_memset64:
+    dsll32 a2, a2, 0
+    dsll32 a3, a3, 0
+    dsrl32 a3, a3, 0
+    or val, a2, a3
+    lw len, 16(sp)
+.Lmemset64:
+#else
+__mi_memset64:
+#endif
     move origptr, ptr
     addiu t0, len, -7
     bltz t0, .Lsmall
